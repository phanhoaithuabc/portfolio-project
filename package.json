{
  "name": "personal-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run portfolio:dev",
    "portfolio:dev": "concurrently -k -n portfolio-api,portfolio-web \"npm run dev:portfolio-api\" \"npm run dev -w @portfolio/web\"",
    "portfolio:preview": "cross-env PORTFOLIO_STORE=file npm run portfolio:dev",
    "dev:portfolio-api": "node --watch --env-file-if-exists=.env.portfolio --import tsx services/portfolio/src/index.ts",
    "portfolio:migrate": "node --env-file-if-exists=.env.portfolio --import tsx services/portfolio/src/migrate.ts",
    "portfolio:media:migrate": "node --env-file-if-exists=.env.portfolio --import tsx scripts/migrate-media-to-s3.ts",
    "portfolio:hash-password": "tsx services/portfolio/src/hash-password.ts",
    "build": "tsc --noEmit && npm run build -w @portfolio/web",
    "build:runtime": "node scripts/build-runtime.mjs",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "ops:ec2": "node ops/aws/ec2.mjs",
    "ops:domain": "node ops/domain.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.82.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@aws-sdk/client-ec2": "^3.1159.0",
    "@electric-sql/pglite": "^0.5.13",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "~7.0.2",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "gaxios": "^7.1.4"
  }
}
